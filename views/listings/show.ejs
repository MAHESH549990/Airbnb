<%- layout("/template/boilerplate.ejs") %>
<body>
    <div class="container-fluid">
      <h5><%=data.title%></h5>
      <img src="<%=data.image.url%>" class="card-img-top-listing" alt="<%=data.image%>" style="border-radius: 1rem; background-repeat: no-repeat;background-size: cover !important;">
      <div>
       <p>
       <b>Owned By: <%=data.owner.username%></b><br/>
       <%=data.description%><br/>
       &#8377; <%=data.price.toLocaleString("en-IN")%><br/>
       <%=data.location%><br/>
       <%=data.country%><br/>
      </p>
      </div>
       <%if(currUser && currUser._id.equals(data.owner.id)){%>
       <div class="mt-3 mb-3 show-btns">
        <form action="/listings/<%=data._id%>/update" method="get" class="mt-5">
          <button class="btn btn-outline-warning">Update Listing</button>
        </form>
        <form action="/listings/<%=data._id%>?_method=DELETE" method="post" class="mt-5" onclick="return confirm('Are you sure to delete this listing ?');">
          <button class="btn btn-outline-danger">Delete</button>
        </form>
        </div>
        <%}%>
        <div class="row my-5">
            <%if(currUser){%>
            <h1 class="mt-3 mb-5"><i class="fa-solid fa-star-half"></i>Add Reviews</h1>
            <form action="/listings/<%=data._id%>/reviews"
        method="post" class="needs-validation" novalidate>
            <div class="mt-3 mb-3 col-sm-12 col-lg-6 col-lg-8">
                <label for="comment" class="form-label">Comment: </label>
                <textarea 
                    type="text" 
                    name="review[comment]" 
                    placeholder="Enter comment" class="form-control border" 
                    id="comment" 
                    rows="4"
                    minlength="5" 
                    required></textarea>
                <div class="valid-feedback">
                  Comment looks good!
                </div>
                <div class="invalid-feedback">
                  Please enter comment!
                </div>
              </div>

          <div class="mt-3 mb-3 col-sm-12 col-lg-6 col-lg-8">
                <label for="image" class="form-label">Add image: </label>
                <input
                    type="text" 
                    name="review[image][url]" 
                    placeholder="Enter image URL" class="form-control border" 
                    id="image" 
                  >
                <div class="valid-feedback">
                  Image URL looks good!
                </div>
                <div class="invalid-feedback">
                  Please enter Image URL!
                </div>
              </div>

              <div class="mt-3 mb-3 col-sm-12 col-lg-6 col-lg-8">
                <label for="rating" class="form-label">Rating: </label>
                <input type="range" step="1" name="review[rating]"   id="rating" min="1" max="5"  required>
              </div>
        </div>
         <button class="btn btn-dark my-4">Add Review</button>
        </form>
        
        <%}%>
        <hr style="height:0.2rem !important; background-color:black" class="my-3">

        <h1 class="mt-3 mb-5"><i class="fa-solid fa-star-half"></i> Reviews</h1>
        <div class="row">
          <%for(review of data.reviews){%>
            <div class="col-lg-6 col-md-6 col-sm-12 my-3  border-0">
            <h5>@<%=review.author.username%></h5>
              <%if(review.image.url){%>
               
              <img src="<%=review.image.url%>" class=" col-lg-3 col-md-4 col-sm-9 my-1 w-50 rounded-3"/>
              <%}%>
            <div class="card-text">
             <p>
              <%=review.comment%>
              <br/>
              <%for(let rating=1;rating<=review.rating;rating++){%>
                 <i class="fa-solid fa-star text-danger"></i>
              <%}%>
              /5</p>
               <form action="/listings/<%=data._id%>/reviews/<%=review._id%>?_method=DELETE" method="post" onclick="return confirm('Are you sure to delete this review ?');">
                <button class="btn btn-outline-danger my-2">Delete</button>
               </form>
            </div>
          </div>
          <%}%> 
        </div>
       </div>

</body>
