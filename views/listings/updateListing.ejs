<%- layout("/template/boilerplate.ejs") %>
<form action="/listings/<%=data._id%>?_method=PUT" method="post" class="mt-5 needs-validation" novalidate>
   <div class="container row">
         <div class="col-md-8 col-sm-11 offset-md-2">
        <h4 class="d-center">Update Listing</h4>
        <div class="mt-3 mb-3">
          <label for="title" class="form-label">Title: </label>
          <input type="text" name="listing[title]" value="<%=data.title%>" class="form-control" id="title" required>
          <div class="valid-feedback">
            Title looks good!
          </div>
          <div class="invalid-feedback">
            Please enter Title!
          </div>
        </div>
        <div class="mt-3 mb-3">
          <label for="description" class="form-label">Description: </label>
          <textarea type="text" name="listing[description]"  class="form-control" id="description" required><%=data.description%> </textarea>
          <div class="valid-feedback">
            Description looks good!
          </div>
          <div class="invalid-feedback">
            Please enter description!
          </div>
        </div>
        <div class="mt-3 mb-3">
          <label for="image" class="form-label">Image/URL: </label>
          <input type="text" name="listing[image][url]" value="<%=data.image.url%>" class="form-control" id="image" required>
          <div class="valid-feedback">
            Image URL looks good!
          </div>
          <div class="invalid-feedback">
            Please enter image URL!
          </div>
        </div>
        <div class="row">
          <div class="mt-3 mb-3 col-md-4">
          <label for="price" class="form-label">Price: </label>
          <input type="number" name="listing[price]" value="<%=data.price%>"  class="form-control" id="price" required>
          <div class="valid-feedback">
            Price looks good!
          </div>
          <div class="invalid-feedback">
            Please enter price!
          </div>
        </div>
        <div class="mt-3 mb-3 col-md-8">
          <label for="country" class="form-label">Country: </label>
          <input type="text" name="listing[country]" value="<%=data.country%>"  class="form-control" id="country" required>
           <div class="valid-feedback">
            Country looks good!
          </div>
          <div class="invalid-feedback">
            Please enter country!
          </div>
        </div> 
        </div>
        <div class="mt-3 mb-5">
          <label for="location" class="form-label">Location: </label>
          <input type="text" name="listing[location]" value="<%=data.location%>"  class="form-control" id="location" required>
           <div class="valid-feedback">
            Location looks good!
          </div>
          <div class="invalid-feedback">
            Please enter location!
          </div>
        </div>
        <button class="btn btn-outline-warning text-black">Update Listing</button>
        </div>
   </div>
</form>