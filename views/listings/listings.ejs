<%- layout("/template/boilerplate.ejs") %>
<div  class="row row-cols-1 row-cols-md-2 row-cols-lg-3" id="listings-div">
    <% for(let data of Alldata) { %>

        <div class="col">
            <a href="/listings/<%=data._id%>">
                <div class="card">
                    <img 
                        src="<%=data.image.url%>" 
                        class="card-img-top"
                        alt="<%=data.title%> image"
                    >

                    <div class="card-body">
                        <p class="card-text">
                            <b><%=data.title%></b><br/>
                            &#8377;<%=data.price.toLocaleString("en-IN")%>/night
                        </p>
                    </div>
                </div>
            </a>
        </div>

    <% } %>
</div>

